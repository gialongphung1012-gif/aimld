# Copy to .env locally; never commit real secrets. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AIMLD_SESSION_SECRET=FILL_RANDOM_SECRET_AT_LEAST_32_CHARS
AIMLD_LICENSE_PEPPER=FILL_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
AIMLD_DATABASE_PATH=./instance/aimld.sqlite3
AIMLD_ADMIN_USERNAME=FILL_ADMIN_USERNAME
AIMLD_ADMIN_PASSWORD=FILL_LONG_UNIQUE_PASSWORD
PORT=9132
COOKIE_SECURE=true
LOG_LEVEL=INFO
